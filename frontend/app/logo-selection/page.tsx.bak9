            {/* Bouncing endpoints of first cross */}
            <circle cx="20" cy="8" r="2" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s' }} />
            <circle cx="32" cy="20" r="2" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '0.5s' }} />
            <circle cx="20" cy="32" r="2" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '1s' }} />
            <circle cx="8" cy="20" r="2" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '1.5s' }} />
            
            {/* Bouncing endpoints of second cross */}
            <circle cx="12" cy="12" r="1.5" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '0.25s' }} />
            <circle cx="28" cy="28" r="1.5" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '0.75s' }} />
            <circle cx="12" cy="28" r="1.5" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '1.25s' }} />
            <circle cx="28" cy="12" r="1.5" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '1.75s' }} />
            
            {/* Center pulse */}
            <circle cx="20" cy="20" r="3.5" fill={secondary} opacity="0.8" className="animate-ping" style={{ animationDuration: '1.5s' }} />
          </svg>
          <div className="font-semibold text-xl">
            <span className="text-transparent bg-clip-text bg-gradient-to-r" style={{
              backgroundImage: `linear-gradient(to right, ${primary}, ${secondary})`
            }}>Med</span>
            <span>Connect</span>
          </div>
        </div>
      );
    },
    
    // Variation 5: Cross in Circle with Orbital Dots
    (id: number) => {
      const primary = primaryColors[4];
      const secondary = secondaryColors[4];
      
      return (
        <div className="logo-option">
          <svg viewBox="0 0 40 40" className={logoStyle}>
            {/* Circle container */}
            <circle cx="20" cy="20" r="18" fill="none" stroke={primary} strokeWidth="1.5" opacity="0.5" />
            
            {/* Cross */}
            <path 
              d="M20 8V32M8 20H32" 
              fill="none" 
              stroke={primary} 
              strokeWidth="3" 
              strokeLinecap="round"
              className="animate-pulse"
            />
            
            {/* Orbiting dots */}
            <circle cx="20" cy="20" r="12" fill="none" className="animate-[show-orbit_3s_ease-in-out_infinite_alternate]" />
            
            <circle 
              cx="20" 
              cy="8" 
              r="2.5" 
              fill={secondary} 
              className="animate-[orbit1_6s_linear_infinite]"
            />
            
            <circle 
              cx="32" 
              cy="20" 
              r="2.5" 
              fill={secondary} 
              className="animate-[orbit2_6s_linear_infinite]"
            />
            
            <circle 
              cx="20" 
              cy="32" 
              r="2.5" 
              fill={secondary} 
              className="animate-[orbit3_6s_linear_infinite]"
            />
            
            <circle 
              cx="8" 
              cy="20" 
              r="2.5" 
              fill={secondary} 
              className="animate-[orbit4_6s_linear_infinite]"
            />
            
            <style jsx>{`
              @keyframes show-orbit {
                0% { opacity: 0; }
                100% { opacity: 0.3; }
              }
              
              @keyframes orbit1 {
                0% { transform: rotate(0deg) translateY(-12px) rotate(0deg); }
                100% { transform: rotate(360deg) translateY(-12px) rotate(-360deg); }
              }
              
              @keyframes orbit2 {
                0% { transform: rotate(90deg) translateY(-12px) rotate(-90deg); }
                100% { transform: rotate(450deg) translateY(-12px) rotate(-450deg); }
              }
              
              @keyframes orbit3 {
                0% { transform: rotate(180deg) translateY(-12px) rotate(-180deg); }
                100% { transform: rotate(540deg) translateY(-12px) rotate(-540deg); }
              }
              
              @keyframes orbit4 {
                0% { transform: rotate(270deg) translateY(-12px) rotate(-270deg); }
                100% { transform: rotate(630deg) translateY(-12px) rotate(-630deg); }
              }
            `}</style>
            
            {/* Center pulse */}
            <circle cx="20" cy="20" r="4" fill={secondary} opacity="0.7" className="animate-ping" style={{ animationDuration: '2s' }} />
          </svg>
          <div className="font-semibold text-xl">
            <span className="text-transparent bg-clip-text bg-gradient-to-r" style={{
              backgroundImage: `linear-gradient(to right, ${primary}, ${secondary})`
            }}>Med</span>
            <span>Connect</span>
          </div>
        </div>
      );
    },
    
    // Variation 6: Medical Plus with Data Flow
    (id: number) => {
      const primary = primaryColors[0];
      const secondary = secondaryColors[0];
      
      return (
        <div className="logo-option">
          <svg viewBox="0 0 40 40" className={logoStyle}>
            {/* Plus symbol */}
            <path 
              d="M20 8V32M8 20H32" 
              fill="none" 
              stroke={primary} 
              strokeWidth="4" 
              strokeLinecap="round"
              className="animate-pulse"
            />
            
            {/* Digital data flowing along the cross */}
            <circle cx="20" cy="12" r="1" fill="white" className="animate-[flow-vertical_3s_linear_infinite]" />
            <circle cx="20" cy="16" r="1" fill="white" className="animate-[flow-vertical_3s_linear_infinite]" style={{ animationDelay: '0.5s' }} />
            <circle cx="20" cy="24" r="1" fill="white" className="animate-[flow-vertical_3s_linear_infinite]" style={{ animationDelay: '1s' }} />
            <circle cx="20" cy="28" r="1" fill="white" className="animate-[flow-vertical_3s_linear_infinite]" style={{ animationDelay: '1.5s' }} />
            
            <circle cx="12" cy="20" r="1" fill="white" className="animate-[flow-horizontal_3s_linear_infinite]" />
            <circle cx="16" cy="20" r="1" fill="white" className="animate-[flow-horizontal_3s_linear_infinite]" style={{ animationDelay: '0.5s' }} />
            <circle cx="24" cy="20" r="1" fill="white" className="animate-[flow-horizontal_3s_linear_infinite]" style={{ animationDelay: '1s' }} />
            <circle cx="28" cy="20" r="1" fill="white" className="animate-[flow-horizontal_3s_linear_infinite]" style={{ animationDelay: '1.5s' }} />
            
            <style jsx>{`
              @keyframes flow-vertical {
                0% { transform: translateY(0); opacity: 0; }
                5% { opacity: 1; }
                45% { opacity: 1; }
                50% { transform: translateY(20px); opacity: 0; }
                100% { transform: translateY(0); opacity: 0; }
              }
              
              @keyframes flow-horizontal {
                0% { transform: translateX(0); opacity: 0; }
                5% { opacity: 1; }
                45% { opacity: 1; }
                50% { transform: translateX(20px); opacity: 0; }
                100% { transform: translateX(0); opacity: 0; }
              }
            `}</style>
            
            {/* Corner dots from Featured Design 3 */}
            <circle cx="11" cy="11" r="2" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s' }} />
            <circle cx="29" cy="11" r="2" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '0.5s' }} />
            <circle cx="11" cy="29" r="2" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '1s' }} />
            <circle cx="29" cy="29" r="2" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '1.5s' }} />
            
            {/* Center node */}
            <circle cx="20" cy="20" r="3" fill={secondary} className="animate-ping" style={{ animationDuration: '1.5s' }} />
          </svg>
          <div className="font-semibold text-xl">
            <span className="text-transparent bg-clip-text bg-gradient-to-r" style={{
              backgroundImage: `linear-gradient(to right, ${primary}, ${secondary})`
            }}>Med</span>
            <span>Connect</span>
          </div>
        </div>
      );
    },
    
    // Variation 7: 3D Rotating Cross with Perspective
    (id: number) => {
      const primary = primaryColors[1];
      const secondary = secondaryColors[1];
      
      return (
        <div className="logo-option">
          <svg viewBox="0 0 40 40" className={logoStyle}>
            {/* Horizontal bar with 3D effect */}
            <rect x="8" y="18" width="24" height="4" rx="2" fill={primary} className="animate-[horizontal-rotate_4s_ease-in-out_infinite]" />
            
            {/* Vertical bar with 3D effect */}
            <rect x="18" y="8" width="4" height="24" rx="2" fill={primary} className="animate-[vertical-rotate_4s_ease-in-out_infinite]" />
            
            <style jsx>{`
              @keyframes horizontal-rotate {
                0%, 100% { transform: scaleX(1); }
                50% { transform: scaleX(0.5); }
              }
              
              @keyframes vertical-rotate {
                0%, 100% { transform: scaleY(1); }
                50% { transform: scaleY(0.5); }
              }
            `}</style>
            
            {/* Animated corner dots */}
            <circle cx="8" cy="18" r="1.5" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s' }} />
            <circle cx="32" cy="18" r="1.5" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '0.5s' }} />
            <circle cx="8" cy="22" r="1.5" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '1s' }} />
            <circle cx="32" cy="22" r="1.5" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '1.5s' }} />
            
            <circle cx="18" cy="8" r="1.5" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '0.25s' }} />
            <circle cx="18" cy="32" r="1.5" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '0.75s' }} />
            <circle cx="22" cy="8" r="1.5" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '1.25s' }} />
            <circle cx="22" cy="32" r="1.5" fill={secondary} className="animate-bounce" style={{ animationDuration: '2s', animationDelay: '1.75s' }} />
            
            {/* Center pulse */}
            <circle cx="20" cy="20" r="3" fill={secondary} className="animate-ping" style={{ animationDuration: '1.5s' }} />
          </svg>
          <div className="font-semibold text-xl">
            <span className="text-transparent bg-clip-text bg-gradient-to-r" style={{
              backgroundImage: `linear-gradient(to right, ${primary}, ${secondary})`
            }}>Med</span>
            <span>Connect</span>
          </div>
        </div>
      );
    }
  ];

  // Update the allLogos array to include the letterformFeaturedVariations
  const allLogos = [
    // Removed top 3 sections
    ...letterformFeaturedVariations,
    ...wordmarks, 
    ...letterforms,
    ...letterformVariations,
    ...lettermarks, 
    ...symbols, 
    ...abstractMarks, 
    ...mascots, 
    ...emblems, 
    ...combinationMarks, 
    ...dynamicMarks, 
    ...animatedLogos,
    ...animatedLetterforms,
    ...animatedSymbols,
    ...advancedAnimations,
    ...mottoAnimatedLogos
  ];

  // Remove the top 3 sections from logoCategories
  const logoCategories = [
    // Removed top 3 sections
    { title: "Medical Cross + Floating H Variations", description: "Seven creative combinations of the medical cross symbol with animated floating dots and dynamic elements", logos: letterformFeaturedVariations },
    { title: "Wordmarks/Logotypes", description: "Text-based logos that spell out company name with distinctive typography", logos: wordmarks },
    { title: "Letterforms", description: "Single letter designs with unique styling and medical elements", logos: letterforms },
    { title: "Letterform Variations", description: "Enhanced cross design (#13) with cross element and full MedConnect logo text", logos: letterformVariations },
    { title: "Lettermarks/Monogram Logos", description: "Abbreviated initials of the company name (MC) as the focal point", logos: lettermarks },
    { title: "Logo Symbols/Brand Marks", description: "Recognizable healthcare imagery that represents the brand", logos: symbols },
    { title: "Abstract Logo Marks", description: "Geometric shapes and patterns that convey medical technology", logos: abstractMarks },
    { title: "Mascots", description: "Character representations of healthcare professionals", logos: mascots },
    { title: "Emblems", description: "Enclosed designs with medical symbols in traditional formats", logos: emblems },
    { title: "Combination Marks", description: "Logos that combine symbols with text in unified designs", logos: combinationMarks },
    { title: "Dynamic Marks", description: "Logos with elements suggesting movement and vitality", logos: dynamicMarks },
    { title: "Animated Logos", description: "Designs with built-in animation effects for digital platforms", logos: animatedLogos },
    { title: "Animated Letterforms", description: "Single letters with dynamic animations and medical elements", logos: animatedLetterforms },
    { title: "Animated Symbols", description: "Healthcare symbols with integrated animations and dynamic text", logos: animatedSymbols },
    { title: "Advanced Animated Transitions", description: "Complex morphing animations with multiple state transitions", logos: advancedAnimations },
    { title: "Platform Motto Animations", description: "Dynamic logos inspired by MedConnect's mission of connecting patients with healthcare providers", logos: mottoAnimatedLogos }
  ];
  
  return (
    <div className={`min-h-screen ${isDarkMode ? 'bg-gray-900 text-white' : 'bg-gray-50 text-gray-900'}`}>
      <div className="container mx-auto py-10 px-4">
        <header className="mb-10 text-center">
          <h1 className="text-3xl md:text-4xl font-bold mb-4">MedConnect Logo Selection</h1>
          <p className="text-lg text-gray-500 dark:text-gray-400 mb-6">Choose from our extensive collection of logo designs with unique numbered options</p>
          <div className="flex justify-center gap-4">
            <button 
              onClick={toggleTheme}
              className={`px-4 py-2 rounded-md ${isDarkMode ? 'bg-gray-800 hover:bg-gray-700' : 'bg-white hover:bg-gray-100 border border-gray-200'}`}
            >
              Toggle {isDarkMode ? 'Light' : 'Dark'} Mode
            </button>
            <Link href="/">
              <button className="px-4 py-2 rounded-md bg-teal-600 hover:bg-teal-700 text-white">
                Return to Home
              </button>
            </Link>
          </div>
        </header>
        
        {/* Category navigation */}
        <div className="mb-12">
          <h2 className="text-xl font-bold mb-4 text-center">Jump to Category</h2>
          <div className="flex flex-wrap justify-center gap-2">
            {logoCategories.map((category, index) => (
              <a 
                key={index} 
                href={`#category-${index+1}`}
                className={`px-3 py-1.5 rounded-full text-sm font-medium ${
                  isDarkMode 
                    ? 'bg-gray-800 hover:bg-teal-900 border border-gray-700' 
                    : 'bg-white hover:bg-teal-50 border border-gray-200 hover:border-teal-300'
                }`}
              >
                {index+1}. {category.title}
              </a>
            ))}
          </div>
        </div>
        
        {/* Logo categories */}
        {logoCategories.map((category, categoryIndex) => (
          <div 
            key={categoryIndex} 
            id={`category-${categoryIndex+1}`} 
            className={`mb-16 p-6 rounded-lg ${
              isDarkMode ? 'bg-gray-800/50 border border-gray-700' : 'bg-white/80 border border-gray-200'
            }`}
          >
            <h2 className="text-2xl font-bold mb-2 text-teal-600 dark:text-teal-400">
              {categoryIndex+1}. {category.title}
            </h2>
            <p className="text-gray-500 dark:text-gray-400 mb-6">{category.description}</p>
            
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              {category.logos.map((renderLogo, logoIndex) => {
                const globalIndex = categoryIndex * 100 + logoIndex + 1;
                return (
                  <motion.div
                    key={logoIndex}
                    whileHover={{ scale: 1.03 }}
                    whileTap={{ scale: 0.98 }}
                    onClick={() => setSelectedLogo(globalIndex)}
                    className={`${logoContainerStyle} ${
                      selectedLogo === globalIndex
                        ? isDarkMode
                          ? 'border-teal-500 bg-teal-900/20'
                          : 'border-teal-500 bg-teal-50'
                        : isDarkMode
                          ? 'border-gray-700 hover:border-gray-600 hover:bg-gray-800/50'
                          : 'border-gray-200 hover:border-gray-300 hover:bg-gray-100/50'
                    } cursor-pointer`}
                  >
                    <div className="text-2xl font-bold mb-4 text-teal-600 dark:text-teal-400">
                      {globalIndex + 1}
                    </div>
                    {renderLogo(globalIndex + 1)}
                  </motion.div>
                );
              })}
            </div>
          </div>
        ))}
        
        {selectedLogo && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className={`mt-10 p-6 rounded-lg border text-center max-w-xl mx-auto ${
              isDarkMode ? 'bg-gray-800 border-teal-500' : 'bg-white border-teal-500'
            }`}
          >
            <h2 className="text-2xl font-bold mb-4">Selected Logo: Design #{selectedLogo}</h2>
            <div className="w-32 h-32 mx-auto mb-6">
              {allLogos[selectedLogo - 1](selectedLogo)}
            </div>
            <p className="text-gray-500 dark:text-gray-400 mb-4">
              This selection has been recorded. The selected logo will be implemented throughout the MedConnect application.
            </p>
            <Link href="/">
              <button className="px-6 py-2 rounded-md bg-teal-600 hover:bg-teal-700 text-white">
                Return to Home
              </button>
            </Link>
          </motion.div>
        )}
      </div>
    </div>
  );
};

export default LogoSelection; 